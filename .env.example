L2_RPC_URL=
L2_DEPLOYER_PRIVATE_KEY=
L2_OWNER_ADDRESS=
L2_OWNER_TYPE=multisig_or_external
L2_AUDITOR1_ADDRESS=
L2_AUDITOR2_ADDRESS=
L2_AUDITOR3_ADDRESS=
