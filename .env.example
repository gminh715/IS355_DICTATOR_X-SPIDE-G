# Sepolia Testnet (keep empty in repo; provide locally only when deploying/testing)
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
SEPOLIA_OWNER_ADDRESS=
SEPOLIA_OWNER_TYPE=multisig_or_external
SEPOLIA_AUDITOR1_ADDRESS=
SEPOLIA_AUDITOR2_ADDRESS=
SEPOLIA_AUDITOR3_ADDRESS=
ETHERSCAN_API_KEY=

# L2 Testnet (Arbitrum Sepolia or Base Sepolia; auditors fall back to SEPOLIA_AUDITOR* if unset)
